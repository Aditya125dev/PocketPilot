# PocketPilot — Environment Configuration Template
# Copy to .env and configure for local or production deployment

ENVIRONMENT=production
PROJECT_NAME="PocketPilot — Student Expense Intelligence"

# Database Configuration (PostgreSQL for Docker/Production, SQLite for quick local test)
POSTGRES_USER=pocketpilot_user
POSTGRES_PASSWORD=pocketpilot_pass_secure2026
POSTGRES_DB=pocketpilot_db
DATABASE_URL=postgresql://pocketpilot_user:pocketpilot_pass_secure2026@postgres:5432/pocketpilot_db
# For standalone local backend testing without docker:
# DATABASE_URL=sqlite:///./pocketpilot.db

# JWT & Authentication (Generate secure 32+ char secret in production: openssl rand -hex 32)
SECRET_KEY=pocketpilot-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS & Domains
CORS_ORIGINS=["http://localhost", "http://localhost:80", "http://localhost:5173", "https://pocketpilot.duckdns.org", "http://pocketpilot.duckdns.org"]
DOMAIN=pocketpilot.duckdns.org

# File Upload Limits
MAX_CSV_FILE_SIZE_BYTES=5242880
